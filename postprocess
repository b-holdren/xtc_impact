#!/bin/bash

if [ ! -f "systems.txt" ]; then
    echo "ERROR: Could not find systems.txt"
    exit 1
fi

while read folder; do
    
     if [[ -z "$folder" ]] || [[ "$folder" == \#* ]]; then
        continue
    fi

    echo "Stitching together files for $folder..."
    
    cat ${folder}/scratch/chunk*_data.tmp | sort -n > ${folder}/final_ccs.xvg
    
    rm -rf ${folder}/scratch
    
done < systems.txt

echo "All done!"